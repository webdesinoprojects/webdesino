# MongoDB content and enquiry store (required for normal website/admin data pages)
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.bbzseyk.mongodb.net/?appName=Cluster0"
MONGODB_DB="webdesino"

# DB Provider Flags (keep Mongo reads enabled for repository-backed features)
DB_PROVIDER="mongo"
DB_READ_LOCATIONS="mongo"
DB_READ_PAGES="mongo"
DB_READ_SERVICES="mongo"
DB_READ_BLOGS="mongo"
DB_READ_ENQUIRIES="mongo"

# Supabase Auth and storage (first two values are required for admin auth and media)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Required only for Supabase admin/setup scripts such as scripts/create-supabase-admin.ts
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Comma-separated allowlist for admin login, protected routes, and password reset.
# Set every real admin email here in production.
ADMIN_EMAILS="admin@yourdomain.com"
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Legacy PostgreSQL / Prisma tooling only, if running older SQL diagnostics or migrations
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."

# CDN Configuration (CRITICAL for bandwidth optimization)
# Set this to your CDN URL (e.g., Cloudflare, Vercel, or custom CDN)
# If not set, will fallback to direct Supabase URL
NEXT_PUBLIC_CDN_URL="https://cdn.yourdomain.com"

# Email notifications for enquiry submissions (optional; records still save if omitted)
# Resend is preferred for career application emails when RESEND_API_KEY is set.
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM="Webdesino Careers <careers@webdesino.com>"
CAREERS_EMAIL_TO="webdesino.com@gmail.com"
# Public HTTPS base URL for email images; localhost cannot load inside email clients.
EMAIL_ASSET_BASE_URL="https://webdesino.com"

# SMTP remains supported as a fallback for enquiry/career emails.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="false"
SMTP_FROM="noreply@webdesino.com"
SMTP_TO="info@webdesino.com"

# ImageKit storage for birthday page uploads only.
# When IMAGEKIT_PRIVATE_KEY is set, birthday images/audio upload to ImageKit instead of Supabase.
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxx"
IMAGEKIT_BIRTHDAY_FOLDER="/birthday"

# Employee authentication (required for employee login/dashboard sessions)
JWT_SECRET="your-jwt-secret-key-here"

# App URL for password reset redirects (recommended locally and required in deployment)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"
GA_MEASUREMENT_ID="G-XXXXXXXXXX"

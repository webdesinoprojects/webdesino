# Database
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..."
MONGODB_URI="mongodb+srv://<db_username>:<db_password>@cluster0.bbzseyk.mongodb.net/?appName=Cluster0"
MONGODB_DB="webdesino"

# DB Provider Flags (strict Mongo mode)
DB_PROVIDER="mongo"
DB_READ_LOCATIONS="mongo"
DB_READ_PAGES="mongo"
DB_READ_SERVICES="mongo"
DB_READ_BLOGS="mongo"
DB_READ_ENQUIRIES="mongo"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# CDN Configuration (CRITICAL for bandwidth optimization)
# Set this to your CDN URL (e.g., Cloudflare, Vercel, or custom CDN)
# If not set, will fallback to direct Supabase URL
NEXT_PUBLIC_CDN_URL="https://cdn.yourdomain.com"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="noreply@webdesino.com"

# JWT
JWT_SECRET="your-jwt-secret-key-here"

# Analytics
NEXT_PUBLIC_VERCEL_ANALYTICS_ID="your-analytics-id"
